@model List<VallejoS_TallerLigaPro.Models.Equipo>

@{
    ViewData["Title"] = "Listado de Equipos";
}

<h2>Listado de Equipos</h2>

<p>
    <a asp-action="Crear" class="btn btn-success">Agregar Equipo</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nombre del equipo</th>
            <th>Partidos Jugados</th>
            <th>Ganados</th>
            <th>Empatados</th>
            <th>Perdidos</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var equipo in Model)
        {
            <tr>
                <td>@equipo.Id</td>
                <td>@equipo.Nombre</td>
                <td>@equipo.PartidosJugados</td>
                <td>@equipo.PartidosGanados</td>
                <td>@equipo.PartidosEmpatados</td>
                <td>@equipo.PartidosPerdidos</td>
                <td>
                    <a asp-action="Eliminar" asp-route-id="@equipo.Id" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
